# Copy to .env for local development. Render sets these in its dashboard
# instead — see README.md for deploy steps.

# Postgres connection string from your Neon (or other Postgres) project.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Leave unset locally. Render sets this automatically; it enables the
# Secure flag on the session cookie (requires https, which Render provides).
# NODE_ENV=production

# Optional, defaults to 4787.
# PORT=4787
